{
  "name": "docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format:biome": "biome format --max-diagnostics=100 --log-kind=compact",
    "format": "prettier --write '**/*.{svelte,css}' && pnpm format:biome . --write",
    "lint:biome": "biome lint .",
    "lint": "pnpm eslint . --fix --ext .svelte && pnpm lint:biome --write",
    "qcheck": "biome check ./src",
    "preview": "vite preview"
  },
